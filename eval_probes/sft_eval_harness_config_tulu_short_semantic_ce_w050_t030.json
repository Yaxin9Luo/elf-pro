      "metadata": "eval_probes/dataset_metadata/tulu3_short_answer_clean_en_10k_train_metadata.jsonl"
    },
    "tulu_short_ablate_pmean_m3_dp050": {
      "label": "Tulu3 Short QA 10K pmean=-3 dp=0.50",
      "cfm": "eval_probes/tulu3_short_ablate_pmean_m3_dp050/cfm_sanity_random256_seed12345_params.json",
      "trajectory": "eval_probes/tulu3_short_ablate_pmean_m3_dp050/sampling_trajectory_random16_seed12345_params.json",
      "metadata": "eval_probes/dataset_metadata/tulu3_short_answer_clean_en_10k_train_metadata.jsonl"
    },
    "tulu_short_semantic_ce_pmean_m3_dp025_w050_t030": {
      "label": "Tulu3 Short QA 10K semantic CE pmean=-3 dp=0.25 w=0.50 t<=0.30",
      "cfm": "eval_probes/tulu3_short_semantic_ce_pmean_m3_dp025_w050_t030/cfm_sanity_random256_seed12345_params.json",
      "trajectory": "eval_probes/tulu3_short_semantic_ce_pmean_m3_dp025_w050_t030/sampling_trajectory_random16_seed12345_params.json",
      "metadata": "eval_probes/dataset_metadata/tulu3_short_answer_clean_en_10k_train_metadata.jsonl"
    },
    "tulu_short_semantic_ce_pmean_m3_dp050_w050_t030": {
      "label": "Tulu3 Short QA 10K semantic CE pmean=-3 dp=0.50 w=0.50 t<=0.30",
      "cfm": "eval_probes/tulu3_short_semantic_ce_pmean_m3_dp050_w050_t030/cfm_sanity_random256_seed12345_params.json",
      "trajectory": "eval_probes/tulu3_short_semantic_ce_pmean_m3_dp050_w050_t030/sampling_trajectory_random16_seed12345_params.json",
      "metadata": "eval_probes/dataset_metadata/tulu3_short_answer_clean_en_10k_train_metadata.jsonl"
    }
  },
  "gates": {
    "A_discrete_short": {
      "label": "A: discrete short answer",
      "description": "yes/no, number, label, symbol, and short structured outputs; checks whether high-noise flow can recover a unique target.",
      "rules": [
        {
          "answer_type": [
            "yes_no",
            "number",
            "single_word_or_symbol",
            "structured_json_or_list"
          ],
          "target_len_bucket": [
            "<=2",
            "3-8",
            "9-16"
          ]
        }
      ]
    },
    "B_natural_short": {
      "label": "B: natural short answer",
      "description": "short phrases, one-sentence answers, short refusals, and natural-language short responses.",
      "rules": [
        {
          "answer_type": [
            "short_phrase",
            "sentence",
            "refusal"
          ],
          "target_len_bucket": [
            "3-8",
            "9-16",
            "17-64"
          ]
        }
      ]
    },
    "C_long_answer": {
      "label": "C: long answer",
      "description": "multi-line, long-form, and long target responses; checks long-horizon sampling drift.",
      "rules": [
        {
          "answer_type": [
            "multi_line",
            "long_form"
          ]
        },
        {
          "target_len_bucket": [
            "17-64",
            ">64"
          ]
        }
      ]
    }
  },
  "gate_thresholds": {
    "clean_decode_min": 0.98,
    "t01_correct_min": 0.8,
    "t01_condition_gap_min": 0.5,
    "trajectory_t0_uniform_min": 0.8,
    "per_gate": {
      "C_long_answer": {
        "_comment": "Long answers should not be judged by token-exact accuracy. token_acc / trajectory thresholds are intentionally relaxed; promote to semantic / structure metrics in a future revision.",
        "clean_decode_min": 0.95,
        "t01_correct_min": 0.4,
        "t01_condition_gap_min": 0.3,
        "trajectory_t0_uniform_min": 0.4,
        "skip_metrics": [
          "t01_correct_min",
          "trajectory_t0_uniform_min"
        ]
      }
    }
  }
}
