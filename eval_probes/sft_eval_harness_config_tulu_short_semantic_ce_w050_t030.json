    },
    "tulu_short_ablate_pmean_m3": {
      "label": "Tulu3 Short QA 10K pmean=-3",
      "cfm": "eval_probes/tulu3_short_ablate_pmean_m3/cfm_sanity_random256_seed12345_params.json",
      "trajectory": "eval_probes/tulu3_short_ablate_pmean_m3/sampling_trajectory_random16_seed12345_params.json",
      "metadata": "eval_probes/dataset_metadata/tulu3_short_answer_clean_en_10k_train_metadata.jsonl"
    },
    "tulu_short_ablate_pmean_m3_dp035": {
      "label": "Tulu3 Short QA 10K pmean=-3 dp=0.35",
      "cfm": "eval_probes/tulu3_short_ablate_pmean_m3_dp035/cfm_sanity_random256_seed12345_params.json",
